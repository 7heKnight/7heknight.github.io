---
import { SOCIAL_LINKS } from '../lib/seo';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <h2>Contact me</h2>
  <div class="socials">
    {SOCIAL_LINKS.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
  </div>
  <p class="copy">
    <a href="/copyright/">Copyright &copy; {year} 7heknight</a>
  </p>
</footer>
