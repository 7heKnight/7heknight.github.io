---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostDates from '../components/PostDates.astro';
import { postCrumbs } from '../lib/posts';
import { REDTEAM_CATEGORIES } from '../content/config';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  cover?: string;
  category: keyof typeof REDTEAM_CATEGORIES;
  tags: string[];
  difficulty: string;
  excerpt: string;
  draft: boolean;
  headings: MarkdownHeading[];
  related?: { slug: string; title: string }[];
}
const {
  title, date, updated, cover, category, tags, difficulty, excerpt, draft,
  headings, related = [],
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout
  title={title}
  description={excerpt}
  image={cover}
  noindex={draft}
  article={{ published: date, modified: updated ?? date, tags, section: REDTEAM_CATEGORIES[category] }}
>
  <div class="container">
    <div class="writeup">
      <aside class="toc">
        <h4>Contents</h4>
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>

      <article class="post">
        <Breadcrumbs crumbs={postCrumbs('redteam', title)} />
        <h1>{title}</h1>
        <p class="post-meta"><PostDates date={date} updated={updated} /> &middot; <span class={`badge ${difficulty}`}>{difficulty}</span></p>
        {draft && <p class="post-meta"><span class="badge draft">draft / incomplete</span></p>}
        <div class="post-tags">
          {tags.map((t) => <a class="tag" href={`/tags/${t.toLowerCase()}/`}>#{t}</a>)}
        </div>
        <div class="body">
          <slot />
        </div>
      </article>

      <aside class="meta-side">
        <div class="block">
          <h4>Category</h4>
          <a class="tag" href={`/redteam/categories/${category}/`}>{REDTEAM_CATEGORIES[category]}</a>
        </div>
        {related.length > 0 && (
          <div class="block related">
            <h4>Related</h4>
            {related.map((r) => <a href={`/redteam/${r.slug}/`}>{r.title}</a>)}
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
