---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, groupByTag } from '../../lib/posts';

const tags = [...groupByTag(await getAllPosts())]
  .map(([tag, posts]) => [tag, posts.length] as const)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<BaseLayout
  title="Tags"
  description="Browse 7heKnight posts by tag across binary exploitation, Android pentest and red team: techniques, tools, CVE identifiers and difficulty."
>
  <div class="container">
    <section class="hero">
      <h1>$ tags --count</h1>
      <p>Filter across all three tracks by source, difficulty, tool and technique.</p>
    </section>
    <div class="taxo-bar">
      {tags.map(([t, n]) => (
        <a class="tag" href={`/tags/${t}/`}>#{t} <span style="opacity:.6">({n})</span></a>
      ))}
    </div>
  </div>
</BaseLayout>
