---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, sortForSection, type Section } from '../lib/posts';

const all = await getAllPosts();
const latest = (section: Section) =>
  sortForSection(section, all.filter((p) => p.section === section)).slice(0, 3);
const writeups = latest('writeups');
const pentest = latest('pentest');
const redteam = latest('redteam');
---
<BaseLayout title="7heKnight">
  <div class="container">
    <section class="hero">
      <h1>7heKnight<span style="color:var(--muted)">$</span></h1>
      <p>
        Offensive security notes — binary exploitation, exploit development,
        mobile pentesting, and red team research. Three tracks, written as
        practical runbooks.
      </p>
    </section>

    <section style="margin-bottom:8px">
      <h2 style="color:var(--accent);font-family:var(--mono);font-size:1.3rem;margin-bottom:4px">
        <a href="/writeups/">Binary Exploitation &amp; CTF &rarr;</a>
      </h2>
      <p style="color:var(--muted);margin-bottom:16px">
        Stack smashing, DEP/NX &amp; ASLR bypass, ret2libc, shellcode, CTF writeups.
      </p>
    </section>
    <div class="card-grid">
      {writeups.map((p) => <PostCard post={p} level="h3" />)}
    </div>

    <section style="margin-bottom:8px">
      <h2 style="color:var(--accent);font-family:var(--mono);font-size:1.3rem;margin-bottom:4px">
        <a href="/pentest/">Mobile Pentest &rarr;</a>
      </h2>
      <p style="color:var(--muted);margin-bottom:16px">
        Android HTTPS interception: cert injection, root &amp; SSL pinning bypass, Frida tooling.
      </p>
    </section>
    <div class="card-grid">
      {pentest.map((p) => <PostCard post={p} level="h3" />)}
    </div>

    <section style="margin-bottom:8px">
      <h2 style="color:var(--accent);font-family:var(--mono);font-size:1.3rem;margin-bottom:4px">
        <a href="/redteam/">Red Team &rarr;</a>
      </h2>
      <p style="color:var(--muted);margin-bottom:16px">
        Cyber kill-chain research: OSINT recon &amp; enumeration, Windows host persistence, lateral movement, insecure deserialization.
      </p>
    </section>
    <div class="card-grid">
      {redteam.map((p) => <PostCard post={p} level="h3" />)}
    </div>
  </div>
</BaseLayout>
